# Get the directory containing this file.
get_filename_component(aria_common_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

# Define the location of the headers and libraries.
# Paths can be configured using configure_file in CMakeLists.txt
set(aria_common_INCLUDE_DIRS "${aria_common_CMAKE_DIR}/../../../include")
set(aria_common_LIBRARIES "${aria_common_CMAKE_DIR}/../../../lib/libaria_common.a")

find_package(spdlog REQUIRED)

# Make the above variables available to the finder.
set(aria_common_FOUND TRUE)
set(aria_common_INCLUDE_DIRS ${aria_common_INCLUDE_DIRS} ${spdlog_INCLUDE_DIRS} CACHE STRING "Aria Common include directories")
set(aria_common_LIBRARIES ${aria_common_LIBRARIES} spdlog::spdlog CACHE STRING "Aria Common libraries")
